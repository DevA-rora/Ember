<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ember.things-sync</string>
  <key>ProgramArguments</key>
  <array>
    <string>__EMBER_SYNC_BIN__</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__EMBER_REPO__</string>
  <key>WatchPaths</key>
  <array>
    <string>__THINGS_DATABASE_DIR__</string>
  </array>
  <key>ThrottleInterval</key>
  <integer>15</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/ember-sync.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/ember-sync.err</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
</dict>
</plist>
